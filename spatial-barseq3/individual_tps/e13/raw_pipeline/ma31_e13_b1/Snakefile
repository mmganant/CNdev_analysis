# Store intermediate results in a dictionary
rule minmax1:
    input:
        fov_files = expand(path + "output/fov{FOV}_align_corr.hdf5", FOV=FOV_minmax),  
    output:
        temp(path + "output/median_max1.hdf5"),
        temp(path + "output/median_min1.hdf5")
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values
    run:
        min_values = []
        max_values = []
        for fov_file in input.fov_files:  # Loop through all FOV input files
            images = open_hdf5(fov_file)  # Load the input file
            images = np.stack(images)
            images = images.reshape(images.shape[0]*images.shape[1], images.shape[2], images.shape[3])            
            # Ensure the output file is correctly set for this specific FOV            
            # Process the images
            min, max = min_max(images)
            min_values.append(min)
            max_values.append(max)
        # Convert the lists to TensorFlow tensors
        min_values_all = np.stack(min_values, axis=0)
        max_values_all = np.stack(max_values, axis=0)
        # Compute the median of the min and max values across all FOVs
        median_min = np.median(min_values_all, axis=0)
        median_max = np.median(max_values_all, axis=0)
        print("medmin_shape: "+str(median_min.shape))
        save_hdf5(median_min, path + "output/median_min1.hdf5")
        save_hdf5(median_max, path + "output/median_max1.hdf5")




rule apply_minmax2:
    input:
        fov_files = [path+"output/fov{FOV}_norm.hdf5"],
        #mask_files = [path + "output/fov{FOV}_mask.hdf5"],
        med_max = path + "output/median_max2.hdf5",
        med_min = path + "output/median_min2.hdf5"
    output:
        temp([path + "output/fov{FOV}_norm_mm2.hdf5"])
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values
    run:
        median_max = open_hdf5(input.med_max)
        median_min = open_hdf5(input.med_min)
        for i in range(len(input.fov_files)):  # Loop through all FOV input files
            #mask = open_hdf5(input.mask_files[i])  # Load the input file
            images = open_hdf5(input.fov_files[i])  # Load the input file
            images = np.stack(images)
            images = images.reshape(images.shape[0]*images.shape[1], images.shape[2], images.shape[3])
            print('medmax2: '+str(len(median_min)))
            print('medmax2: '+str(len(median_min[0].shape)))
            images = (images - median_min) / median_max
            images = np.clip(images,0,1)
            images = np.stack(images)
            images = images.reshape(int(images.shape[0]/4),4, images.shape[1], images.shape[2])
            fov_sample = int(input.fov_files[i].split('fov')[-1].split('_')[0])
            #images_mask = apply_mask_to_images(images, mask)
            save_hdf5(images, path + "output/fov"+str(fov_sample)+"_norm_mm2.hdf5")




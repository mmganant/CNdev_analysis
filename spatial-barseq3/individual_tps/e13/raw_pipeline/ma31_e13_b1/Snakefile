	adata_sub = sc.read_h5ad(input.h5ad)

	adata_sub = combine_and_rename_genes(adata_sub, [])
	cellxgene = pd.DataFrame(adata_sub.X, index = range(len(adata_sub.X)), columns = adata_sub.var_names)
	metadata = pd.DataFrame(np.stack([adata_sub.obsm['spatial'][:,1],adata_sub.obsm['spatial'][:,0],adata_sub.obsm['spatial'][:,1],adata_sub.obsm['spatial'][:,0],np.array(range(len(adata_sub.X))).astype(np.int64)], axis =1), columns = ['cell', 'center_x', 'center_y','min_x', 'min_y'])
	metadata['cell'] = metadata['cell'].astype(int)
	metadata['max_x'] = metadata['min_x']
	metadata['max_y'] = metadata['min_y']

	cellxgene_reset = cellxgene.reset_index().melt(id_vars='index', var_name='gene', value_name='expression')
	cellxgene_reset.rename(columns={'index': 'cell'}, inplace=True)
	final_df = cellxgene_reset.merge(metadata, on='cell')
	detected_transcripts = final_df[[ 'center_x', 'center_y','gene']]
	detected_transcripts['global_x'] = detected_transcripts['center_x']
	detected_transcripts['global_y'] = detected_transcripts['center_y']
	detected_transcripts['x'] = detected_transcripts['center_x']
	detected_transcripts['y'] = detected_transcripts['center_y']
	detected_transcripts['global_z'] = 0
	#if not os.path.exists(path_to_vizgen):
	#	os.makedirs(path_to_vizgen)
	cellxgene.to_csv(path + "output/vizgen/cell_by_gene.csv")
	metadata.to_csv(path + "output/vizgen/cell_metadata.csv")
	detected_transcripts.to_csv(path + "output/vizgen/detected_transcripts.csv")
 
rule output_dapi_image:
    input:
        dapi = expand(path + "output/fov{FOV}_dapi.hdf5", FOV=FOVs),
        mask = expand(path + "output/fov{FOV}_dapi_mask_exp.hdf5", FOV=FOVs),
        positions = path + "position_org.csv"
    output:
        dapi_img = path + "output/vizgen/dapi_image.tif",
        mask_img = path + "output/vizgen/mask_image.tif"
    wildcard_constraints:
        FOV = r"\d+"
    run:
        import os
        import numpy as np
        import pandas as pd
        from tifffile import imsave

        positions = pd.read_csv(input.positions)

        dapi_all = []
        mask_all = []

        use_collapsed_z = os.path.exists(dapi_path + "dapi_all_z.npy")

        for dapi_file, mask_file in zip(input.dapi, input.mask):
            dapi_img = open_hdf5(dapi_file)
            mask_img = open_hdf5(mask_file)

            if use_collapsed_z:
                dapi_img = np.sum(dapi_img, axis=0)  # Collapse Z
                # mask_img = np.sum(mask_img, axis=0)  # Uncomment if needed

            dapi_all.append(dapi_img)
            mask_all.append(mask_img)

        dapi_all = np.stack(dapi_all, axis=0)
        mask_all = np.stack(mask_all, axis=0)

        img_h, img_w = dapi_all[0].shape
        

        # Adjust positions
        offset_x = positions['X'].min()
        offset_y = positions['Y'].min()
        positions_adj = positions.copy()
        positions_adj['X'] = np.max(positions['X']) - positions['X']
        positions_adj['X'] -= positions_adj['X'].min()
        positions_adj['Y'] = np.max(positions['Y']) - positions['Y'] - offset_y
        positions_adj['Y'] -= positions_adj['Y'].min()

        # Determine stitched image size
        grid_w = int((positions_adj['X'].max() // img_w + 1) * img_w) + 2304
        grid_h = int((positions_adj['Y'].max() // img_h + 1) * img_h) + 2304

        stitched_dapi = np.zeros((grid_h, grid_w), dtype=dapi_all[0].dtype)
        stitched_mask = np.zeros((grid_h, grid_w), dtype=mask_all[0].dtype)

        for idx, (dapi_img, mask_img) in enumerate(zip(dapi_all, mask_all)):
            pos = positions_adj.loc[idx]
            x0 = int(pos['X'])
            y0 = int(pos['Y'])

            stitched_dapi[y0:y0+img_h, x0:x0+img_w] = dapi_img
            stitched_mask[y0:y0+img_h, x0:x0+img_w] = mask_img
        stitched_dapi = (255*stitched_dapi-np.max(stitched_dapi))/(np.max(stitched_dapi)-np.min(stitched_dapi)).astype(np.uint8)
        stitched_dapi = stitched_mask.astype(np.uint16)
        imsave(output.dapi_img, stitched_dapi)
        imsave(output.mask_img, stitched_mask)



rule output_individual_cell_boundaries:
	input:
		mask_images = path + "output/fov{FOV}_dapi_mask_exp.hdf5",  # Single FOV input
		all_cell_boundaries = path + "output/all_fov_cell_boundaries.csv"
	params:
		positions_glob = positions_glob
	output:
		path + "output/cell_boundaries/feature_data_{FOV}.hdf5"  # Output for each FOV
	wildcard_constraints:
		FOV = r"\d+"  # Only numeric FOV values
	run:
		import h5py
		import numpy as np
		import pandas as pd
		from cellpose import utils  # Assuming utils is needed
		
		os.makedirs(path + "output/cell_boundaries", exist_ok=True)

		# Read position data
		positions_glob = pd.read_csv(params.positions_glob)
		FOV = int(wildcards.FOV)
	
		# Open the mask for the current FOV (Snakemake will handle FOV as a wildcard)
		mask_fov_path = input.mask_images
		with h5py.File(mask_fov_path, 'r') as mask_fov:
			# Create output HDF5 for the current FOV
			output_fov_path = output[0]
			mask_fov = open_hdf5(mask_fov_path)
			mask_fov = np.array(mask_fov, dtype=int)
			with h5py.File(output_fov_path, 'w') as test_fov:
				# Iterate over unique IDs in the mask
				for ID in range(1, np.max(mask_fov) + 1):
					temp = np.zeros((2304, 2304))
					x, y = np.where(mask_fov == ID)
					temp[x, y] = str(ID) + '_' + str(FOV)
					
					#Get outlines from the mask
					outlines = utils.masks_to_outlines(temp)
					x, y = np.nonzero(outlines)
					
					#Compute global positions
					glob_x = (x + positions_glob.iloc[FOV]['X'] - 2304 / 2).astype(int)
					glob_y = (y + np.max(positions_glob['Y']) - positions_glob.iloc[FOV]['Y']).astype(int)
					
					#Assuming glob_x and glob_y are the coordinates
					center_x = np.mean(glob_x)
					center_y = np.mean(glob_y)

					#Calculate the angle for each point relative to the center
					angles = np.arctan2(glob_y - center_y, glob_x - center_x)
						
					#Sort the points by angle
					sorted_indices = np.argsort(angles)
					
					#Rearrange the coordinates based on the sorted angles
					sorted_glob_x = glob_x[sorted_indices]
					sorted_glob_y = glob_y[sorted_indices]
				
					#Create a data array of coordinates
					data_array = np.column_stack((sorted_glob_x, sorted_glob_y))
					cell_id = str(ID) + '_' + str(FOV)
					
					#Create group and dataset for the current cell
					test_fov.create_group(f"/featuredata/{cell_id}/zIndex_0/p_0/")
					test_fov.create_dataset(f"/featuredata/{cell_id}/zIndex_0/p_0/coordinates", data=data_array)

rule merge_all_cell_boundaries_info:
    input:
        fov_files = expand(path + "output/fov{FOV}_cell_boundaries_output.csv", FOV=FOVs)
    output:
        path + "output/all_fov_cell_boundaries.csv"
    wildcard_constraints:
        FOV = r"\d+"  # Ensures FOV is numeric
    run:
        if output_cellboundaries:
            import pandas as pd
            import numpy as np
            from pandas.errors import EmptyDataError

            all_fov_cell_boundaries = pd.DataFrame()

            for fov_file in input.fov_files:
                # Attempt to read each CSV
                try:
                    df = pd.read_csv(fov_file)
                except EmptyDataError:
                    print(f"[merge_all_cell_boundaries_info] Skipping truly empty file {fov_file}.")
                    continue

                if df.empty:
                    print(f"[merge_all_cell_boundaries_info] Skipping empty (header-only) file {fov_file}.")
                    continue

                all_fov_cell_boundaries = pd.concat(
                    [all_fov_cell_boundaries, df],
                    ignore_index=True
                )

            all_fov_cell_boundaries.to_csv(output[0], index=False)
            print(f"[merge_all_cell_boundaries_info] Wrote merged cell boundaries: {output[0]}")



rule output_cellsegmentation_information:
    input:
        mask_images = path + "output/fov{FOV}_dapi_mask_exp.hdf5",
        gene_mapped = path + "output/fov{FOV}_genemapped.csv"
    params:
        positions_glob = positions_glob
    output:
        # The boundaries CSV is declared temp so Snakemake can delete it after merging,
        # but you can remove `temp` if you want to keep it.
        temp(path + "output/fov{FOV}_cell_boundaries_output.csv")
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values
    run:
        import pandas as pd
        import numpy as np
        from cellpose import utils  # If needed

        positions_glob_df = pd.read_csv(params.positions_glob)

        # Identify this FOV from the filename
        mask_fov_path = input.mask_images
        FOV = int(mask_fov_path.split('fov')[-1].split('_')[0])

        # --- 1) Check if gene_mapped is empty. ---
        gene_mapped_path = input.gene_mapped

        # If the file is truly empty (no header) -> raises EmptyDataError
        # or if it has a header but no rows -> df.empty is True
        try:
            gene_df = pd.read_csv(gene_mapped_path)
            if gene_df.empty:
                print(f"[output_cellsegmentation_information] {gene_mapped_path} is empty. " 
                      f"Writing empty boundaries for FOV {FOV}.")
                # Write an empty CSV with the columns you use below
                empty_cols = ['cell_id', 'fov_x', 'fov_y', 'glob_x', 'glob_y']
                pd.DataFrame(columns=empty_cols).to_csv(
                    output[0], index=False
                )
                return
        except pd.errors.EmptyDataError:
            print(f"[output_cellsegmentation_information] {gene_mapped_path} has no data at all. " 
                  f"Writing empty boundaries for FOV {FOV}.")
            empty_cols = ['cell_id', 'fov_x', 'fov_y', 'glob_x', 'glob_y']
            pd.DataFrame(columns=empty_cols).to_csv(
                output[0], index=False
            )
            return

        # --- 2) Load mask as before ---
        mask_fov = open_hdf5(mask_fov_path)
        mask_fov = np.array(mask_fov, dtype=int)

        # Build up the boundary info
        output_all = pd.DataFrame()
        max_label = np.max(mask_fov)
        if max_label == 0:
            # If the mask is all zeros, also produce an empty CSV
            print(f"[output_cellsegmentation_information] Mask is all zeros for FOV {FOV}, "
                  "so no cell boundaries.")
            empty_cols = ['cell_id', 'fov_x', 'fov_y', 'glob_x', 'glob_y']
            pd.DataFrame(columns=empty_cols).to_csv(output[0], index=False)
            return

        # Loop over each cell ID
        for ID in range(1, max_label + 1):
            x, y = np.where(mask_fov == ID)
            temp = np.zeros((2304, 2304), dtype=int)
            temp[x, y] = ID  # store numeric ID (not string)

            outlines = utils.masks_to_outlines(temp)
            x_outline, y_outline = np.nonzero(outlines)

            cell_id = f"{ID}_{FOV}"

            # Compute global x and y
            glob_x = (x_outline + positions_glob_df.iloc[FOV]['X'] - 2304 / 2).astype(int)
            glob_y = (y_outline + np.max(positions_glob_df['Y']) 
                       - positions_glob_df.iloc[FOV]['Y']).astype(int)

            # Create a DataFrame for these boundary points
            out_df = pd.DataFrame({
                'cell_id': [cell_id]*len(x_outline),
                'fov_x': x_outline,
                'fov_y': y_outline,
                'glob_x': glob_x,
                'glob_y': glob_y
            })

            # Concatenate into our overall table
            output_all = pd.concat([output_all, out_df], ignore_index=True)

        # Save
        output_all.to_csv(output[0], index=False)
        print(f"[output_cellsegmentation_information] Wrote cell boundaries to {output[0]}")





def find_params_gradient(image, fov_sample, codeflat, codebook, genenames,fdr_thresh, noisefloor, len_wid, round_num, nogene_keyword, precision, output_path):
    noisefloor = noisefloor
    print("False Detection Rate: "+str(fdr_thresh))
    print(datetime.now().strftime("%d/%m/%Y %H:%M:%S"), "        "+'initialize thresh level for optimization')
    ercc_maxes = []
    print("Nogene codes: " + str(ercc_codes))
	#print(ercc_names)
	#ercc_names = [s for s in genenames if nogene_keyword in s]
	#ercc_codes = np.where(np.in1d(genenames, ercc_names))[0]
	
    print("Image dimensions: " + str(image.shape))
    Xflat = image.reshape(image.shape[0]*image.shape[1],1,image.shape[2], image.shape[3])
    print("Xflat dimenstions: " + str(Xflat.shape))
    et = bardensr.spot_calling.estimate_density_singleshot(Xflat, codeflat, 0.05)  #<--NOTE: we could save this et because we'll use it later but computing et isn't actually much slower than loading it from disk... :)
    print("Print et dimensions: " + str(et.shape))
    ercc_maxes.append(et[:,:,:,ercc_codes].max(axis=(0,1,2))) # max value (single value for each no gene) of the evidence tensor for each fov
    ercc_maxes = np.array(ercc_maxes) #This is the max values of all unused barcodes in all fovs. 	 
    thresh = np.median(np.median(ercc_maxes, axis=1)) #median across fovs of the median across no genes # this is the initial thresh level for optimization
    print("Initial Threshold: " + str(thresh))
    if np.isnan(thresh):
        thresh = 0.7
    print(datetime.now().strftime("%d/%m/%Y %H:%M:%S"), "        "+'    initial thresh from calculation: '+str(thresh)) 
    print(datetime.now().strftime("%d/%m/%Y %H:%M:%S"), "        "+'refine threshold by gradient convergence')
    diff = 1.0
    stepsize = 0.1
    thresh_list, fdr_list =[], []
    while abs(diff) > precision: # diff = 5% - threshold
            print(thresh)#nogenes_calls, genes_calls = [], []
            nogenes_calls, genes_calls = [], []
            #for i in range(len(image)):
            spots = call_genes_large_data(image, codeflat, codebook, genenames,thresh, noisefloor, len_wid, round_num, fov_sample, find_thresh = True)
			#spots = pd.concat(spots)
            no_genes_called = len(np.unique(spots.iloc[np.where(np.isin(spots['j'],ercc_codes))]['j'])) + 0.01
            genes_called = len(np.unique(spots['j'])) - no_genes_called + 0.01
            ercc_c = len(spots.iloc[np.where(np.isin(spots['j'],ercc_codes))]['j'])
            nogenes_calls.append(ercc_c)
            genes_calls.append(len(spots)-ercc_c)
		# divide by all gene num
            nogene_avg = np.mean(nogenes_calls)/len(ercc_names)
            trgene_avg = np.mean(genes_calls)/(len(genenames)-len(ercc_names))
            fdrmean = nogene_avg / (trgene_avg + 0.001)	
            thresh_list.append(thresh)
            fdr_list.append(fdrmean)
            diff = fdr_thresh - fdrmean
            print(datetime.now().strftime("%d/%m/%Y %H:%M:%S"), "        "+'    thresh: '+str(thresh)+'; fdrmean: '+str(fdrmean)+'; diff:'+str(diff))
            thresh -= stepsize * diff / abs(diff)
            stepsize /= 2
    thresh_refined = thresh_list[-1]
    print ("thresh_refined: "+str(thresh_refined))
    with open(path+"output/thresh_refined"+str(fov_sample)+".txt", 'w') as file:
            file.write(f"{thresh_refined}\n")




import tensorflow as tf
def gaussian_filter_1d(X,sigma,axis):
    '''
    Gaussian filter along a single axis of a tensor

    Input:

    - X (a tensor with a float-ish dtype)
    - sigma (will be cast to float64)
    - axis (integer)

    Output: tensor with the same shape and dtype as "X",
    blurred along "axis" with a gaussian filter with
    "sigma" pixels of standard deviation.
    '''
    sigma=tf.cast(sigma,dtype=tf.float64)
    return tf.cond(
        sigma==tf.cast(0,tf.float64),
        lambda: X,
        lambda: _gaussian_filter_1d(X,sigma,axis),
    )

def _gaussian_filter_1d(X,sigma,axis):
    '''
    X -- tensor
    sigma -- scalar
    axis

    filters X over axis
    '''
    # construct filter (in float64 land)
    xs = tf.range(1,sigma*3+1,dtype=tf.float64)
    zero= tf.cast(0,dtype=tf.float64)[None]
    xs = tf.concat([-tf.reverse(xs,(0,)),zero,xs],axis=0)

    filt=tf.math.exp(-.5*xs**2/(sigma*sigma))
    filt=filt/tf.reduce_sum(filt)
    filt=filt[:,None,None] # width x 1 x 1

    # cast filter to X dtype
    filt=tf.cast(filt,dtype=X.dtype)

    # transpose X so that the spatial dimension is at the end
    axes=list(range(len(X.shape)))
    axes[-1],axes[axis]=axes[axis],axes[-1]
    X_transposed=tf.transpose(X,axes) # everythingelse x axis x 1

    # do convolution
    X_convolved_transposed=tf.nn.conv1d(X_transposed[None,...,None],filt,1,'SAME')[0,...,0]

    # transpose back
    X_convolved=tf.transpose(X_convolved_transposed,axes)

    return X_convolved


def dapi_partialz_seg(dapi_all_z_images, fov_sample, expand_dist, diameter=6/0.16, channels=[0,0], model_type="cyto3", restore_type="upsample_cyto3", nframes=1, int_thresh = 0.85, flow_threshold=20, radius =100): #0-255 intensity values
    dapi_all_z = dapi_all_z_images

    dapi_merged = []
    intensity = []
    for j in range(len(dapi_all_z)):
        intensity.append(np.mean(dapi_all_z[j].ravel()))
    intensity = intensity - np.min(intensity)
    z_pos = []
    for k in range(len(intensity)):
        if intensity[k]>int_thresh*np.max(intensity):
            if len(z_pos) <nframes:
                z_pos.append(k)
        #dapi_merged.append(np.sum(dapi_all_z[i][z_pos], axis = 0))
    temp = np.sum(dapi_all_z[z_pos], axis = 0)
    print(1)
    temp = (temp/np.max(temp)).astype(float)
    #temp=tf.clip_by_value(temp,0,temp.dtype.max)
    dapi_merged=np.array(temp)
    print("Denoise and segment...")
    model = denoise.CellposeDenoiseModel(gpu=True, model_type=model_type, restore_type=restore_type)
    masks, flows, styles, upsampled_img = model.eval(dapi_merged, diameter=diameter, channels=channels, flow_threshold=flow_threshold)
    expanded = expand_labels(masks, expand_dist)
    save_hdf5(expanded, path + "output/fov"+str(fov_sample)+"_dapi_mask_exp.hdf5")




def segment_maxproj_images(dapi_images, nissl_images, fov_sample, expand_dist, cellpose_model= cellpose_model, model_type="cyto3", restore_type="upsample_cyto3", cellpose_channel=[0,0], cellpose_diameter=6/0.16):
	# prep images
	if (dapi_images is not None) and (nissl_images is not None):
		#     merged_images.append(np.stack([np.zeros(dapi_images[i].shape), nissl_images[i]/np.max(nissl_images[i]), dapi_images[i]/np.max(dapi_images[i])], axis =2))
		merged_images = np.stack([np.zeros(dapi_images.shape), nissl_images/np.max(nissl_images), dapi_images/np.max(dapi_images)], axis =2)
	elif (dapi_images is not None) and (nissl_images is None):
		merged_images = dapi_images
	elif (dapi_images is None) and (nissl_images is not None):
		merged_images = nissl_images
	model = denoise.CellposeDenoiseModel(gpu=False, model_type=model_type, restore_type=restore_type)
	masks, flows, styles, diams = model.eval(merged_images, diameter=cellpose_diameter, channels=cellpose_channel)
	
	# all_masks.append(masks)
	masks = expand_labels(masks, expand_dist)
	# return all_masks
	save_hdf5(masks, path + "output/fov"+str(fov_sample)+"_dapi_mask_exp.hdf5")


def map_gene2cell(genes_result_fov, mask, FOV, position_reg, dim, xdim, ydim):
    # 1) If mask is all zeros, write an empty CSV and return
    if np.max(mask) == 0:
        print(f"FOV {FOV} has an all-zero mask; writing empty CSV.")
        # Create an empty DataFrame with the columns you expect
        columns = [
            "m1", "m2", "FOV", "cell_ID",
            "cell_center_X", "cell_center_Y",
            "cell_center_globX", "cell_center_globY",
            "cell_number", "cell_globID"
        ]
        empty_df = pd.DataFrame(columns=columns)
        empty_df.to_csv(path + f"output/fov{FOV}_genemapped.csv", index=False)
        return

    # 2) Otherwise, proceed with normal segmentation logic
    from skimage import measure
    # Label connected components in the mask image
    labeled_mask = measure.label(mask)

    # Fill in cell_ID for each gene (row in genes_result_fov)
    genes_result_fov["cell_ID"] = mask[
        genes_result_fov["m1"].astype(int),
        genes_result_fov["m2"].astype(int)
    ]

    # Filter out genes that map to background (cell_ID = 0)
    genes_result_fov = genes_result_fov[genes_result_fov["cell_ID"] != 0]

    # Get centroids for labeled regions
    props = measure.regionprops(labeled_mask)
    centroids = np.array([prop.centroid for prop in props])  # shape: (#cells, 2)

    # Assign centroid coordinates
    cell_num = genes_result_fov["cell_ID"].values - 1
    x_centers = centroids[cell_num.astype(int), 0]
    y_centers = centroids[cell_num.astype(int), 1]

    genes_result_fov["cell_center_X"] = x_centers
    genes_result_fov["cell_center_Y"] = y_centers

    # Global positions
    genes_result_fov["cell_center_globX"] = (
        x_centers + position_reg["X"][FOV] - 2304 / 2
    )
    genes_result_fov["cell_center_globY"] = (
        y_centers - position_reg["Y"][FOV] + np.max(position_reg["Y"])
    )

    # Unique per-FOV cell IDs
    genes_result_fov["cell_number"] = (
        genes_result_fov["cell_ID"].astype(str) + "_" + genes_result_fov["FOV"].astype(str)
    )
    genes_result_fov["cell_globID"] = genes_result_fov.groupby(["FOV","cell_ID"]).ngroup()

    # Save to CSV
    out_file = path + f"output/fov{FOV}_genemapped.csv"
    genes_result_fov.to_csv(out_file, index=False)
    print(f"Wrote {out_file}")



def convert_to_annData(gene_mat_df):
    # Handle missing values by filling them with zeros
    gene_mat_df.fillna(0, inplace=True)

    # Group by 'cell_globID' and 'Names' and count occurrences
    gem = gene_mat_df.groupby(['cell_number', 'Names']).size().unstack(fill_value=0)
    print
    # Compute mean coordinates for each cell ID
    coordinates = gene_mat_df.groupby('cell_number')[['globX', 'globY']].mean()
    print(len(coordinates))
    # Reset index to ensure unique ascending numeric IDs
    coordinates.reset_index(inplace=True)

    # Create AnnData object
    adata = ad.AnnData(gem)
    adata.var['genes'] = gem.columns.tolist()  # Assigning actual gene names as 'genes'
    adata.obs['cell_number'] = gem.index.tolist()  # Using 'cell_globID' as cell_number
    #adata.obsm['spatial'][:,0] = adata.obsm['spatial'][:,0] + 1152 
    coord = np.array([[coordinates['globX'][i], coordinates['globY'][i]] for i in range(len(coordinates['globX']))] )
    print(coord)
    adata.obsm['spatial'] = coord
    adata.obsm['spatial'][:,0] = adata.obsm['spatial'][:,0] + 1152
    return adata




def create_codebook(filepath_codebook, round_num, base_code): # working with round index
    genenames, gene_codes = [], []
    with open(filepath_codebook, newline='') as f:
        reader = csv.reader(f)
        for row in reader:
            check_head = set(row[1])
            available = set('ATGC')
            if check_head.issubset(available):
                if row[0].__contains__(codecs.BOM_UTF8.decode(f.encoding)):
                # A Byte Order Mark is present
                    genenames.append(row[0].strip(codecs.BOM_UTF8.decode(f.encoding)))
                else:
                    genenames.append(row[0])
                barcode = np.array([*row[1]])
                # print(barcode)
                barcode_subset = barcode[round_num]
                # print(barcode_subset)
                gene_codes.append(barcode_subset)
    print(datetime.now().strftime("%d/%m/%Y %H:%M:%S"))
    codebook = np.full((len(round_num), 4, len(gene_codes)), False)
    for tagNum, tag in enumerate(gene_codes):
        for roundNum, letter in enumerate(tag):
            if letter == base_code[0]: 
                codebook[roundNum, 0, tagNum] = True
            if letter == base_code[1]: 
                codebook[roundNum, 1, tagNum] = True
            if letter == base_code[2]: 
                codebook[roundNum, 2, tagNum] = True
            if letter == base_code[3]: 
                codebook[roundNum, 3, tagNum] = True
    codeflat = codebook.reshape((codebook.shape[0]*codebook.shape[1],-1)) # R,C,J=codebook.shape
    return codebook, genenames, codeflat

# Codebook creation
codebook, genenames, codeflat = create_codebook(codebook_path, round_num, base_code)
ercc_names = [s for s in genenames if nogene_keyword in s]
ercc_codes = np.where(np.in1d(genenames, ercc_names))[0]



def combine_and_rename_genes(adata, unwanted_genes):
   
    gene_sums = {}
    # Iterate through the var_names to process them
    for var_name in adata.var_names:
        if ':' in var_name:
            # Get the base name before the colon
            base_name = var_name.split(':')[0]
            if base_name in gene_sums:
                # Sum the values for duplicates
                gene_sums[base_name] += adata[:, var_name].X
            else:
                # Initialize with the current values
                gene_sums[base_name] = adata[:, var_name].X
        else:
            # Copy over values for non-colon names
            if var_name not in gene_sums:
                gene_sums[var_name] = adata[:, var_name].X

    # Update var_names and the X values in the AnnData object
    new_var_names = list(gene_sums.keys())
    new_X = np.array(list(gene_sums.values()))
    print(new_X.shape)
    # Assign the updated names and values back to the AnnData object
    adata_new = ad.AnnData(new_X[:,:,0].T)
    adata_new.var_names = new_var_names
    adata_new.obs = adata.obs
    #adata_new.var = adata.var
    adata_new.obsm = adata.obsm

    #adata_new.var_names = new_var_names
    #adata_new.X = new_X

    # Filter out unwanted genes
    gene_list = [gene for gene in adata_new.var_names if gene not in unwanted_genes]
    adata_new = adata_new[:, gene_list]

    return adata_new








rule export_cellxgene_format:
    input:
        h5ad = path + "output/adata.h5ad",
        dapi_img = path + "output/vizgen/dapi_image.tif",

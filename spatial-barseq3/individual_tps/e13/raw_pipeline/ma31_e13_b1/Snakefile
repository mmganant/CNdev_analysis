    output:
        [path+"output/fov{FOV}_genes.csv"]
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values  
    run:
        with open(input.thresh_path, 'r') as file:
            raw_value = file.read().strip()
            # Parse tuple-like string and extract the float
            thresh_calc = float(raw_value.strip("()").split(",")[0])
        for fov_file in input.fov_files:  # Loop through all FOV input files
            images = open_hdf5(fov_file)  # Load the input file

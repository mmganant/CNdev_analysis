rule generate_gtca_files:
    input:
        gtca_images = gtca_path + "image_origin.hdf5"
    output:
        temp(expand(path + "output/fov{FOV}.hdf5", FOV = FOVs))
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values
    run:
        gtca_images = open_hdf5(input.gtca_images)
        for i in range(len(gtca_images)):  # Loop through all FOV input files
            if i in FOVs:
                save_hdf5(gtca_images[i][round_num], path+"output/fov"+str(i)+".hdf5")


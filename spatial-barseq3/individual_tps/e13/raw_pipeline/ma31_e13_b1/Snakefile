		if find_threshold == True:
			with open(input.thresh_path, 'r') as file:
				init_thresh = float(file.read().strip())
			genes_call_all = []
			for gfile in input.genes_calls:
				with open(gfile, 'r') as f:
					raw_value = f.read().strip()
					g = list(np.fromstring(raw_value.strip('[]'), sep=', '))
					print(g)
					genes_call_all.append(g) 

			genes_call_all = np.stack(genes_call_all, axis = 0) #stacked together
			thresh_list_ref = np.mean(genes_call_all, axis = 0) #average out the refined threshold

			print(thresh_list_ref.shape)

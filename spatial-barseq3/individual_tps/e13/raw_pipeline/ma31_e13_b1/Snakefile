from skimage.feature import blob_dog, blob_log, blob_doh


import cv2
import numpy as np
from skimage.feature import blob_dog

def blobs_to_keypoints(blobs):
    """Convert skimage blob_dog output to OpenCV KeyPoint objects"""
    return [cv2.KeyPoint(float(x), float(y), float(radius * 2)) for y, x, radius in blobs]

def detect_and_match(c1, c2, use_cv2_blob_detector=True):
    """Detect blobs and match SIFT descriptors between two images"""
    if use_cv2_blob_detector:
        params = cv2.SimpleBlobDetector_Params()
        params.blobColor = 255
        params.minThreshold = 5
        params.maxThreshold = 250
        params.filterByArea = False
        params.maxArea = 1000
        params.filterByCircularity = False
        params.minCircularity = 0.5
        params.filterByInertia = False
        params.minInertiaRatio = 0.01
        detector = cv2.SimpleBlobDetector_create(params)
        keypoints1 = detector.detect(c1)
        keypoints2 = detector.detect(c2)
    else:
        blobs1 = blob_dog(c1, max_sigma=30, threshold=0.1)
        blobs2 = blob_dog(c2, max_sigma=30, threshold=0.1)
        keypoints1 = blobs_to_keypoints(blobs1)
        keypoints2 = blobs_to_keypoints(blobs2)

    print('pts1', len(keypoints1))
    print('pts2', len(keypoints2))

    sift = cv2.SIFT_create()
    keypoints1, descriptors1 = sift.compute(c1, keypoints1)
    keypoints2, descriptors2 = sift.compute(c2, keypoints2)

    bf = cv2.BFMatcher(cv2.NORM_L2, crossCheck=True)
    matches = bf.match(descriptors1, descriptors2)
    matches = sorted(matches, key=lambda x: x.distance)

    return keypoints1, keypoints2, matches

def channel_alignment_get_transforms_opencv_sm(images):
    """
    Aligns channel 3 to channel 2 for each round using SIFT + blob matching.
    Assumes images shape: (round, channel, height, width)
    Returns: list of homography transforms (one per round)
    """
    transforms = []
    images = np.stack(images, axis=0)
    print("Shape of images after stacking:", images.shape)

    for i in range(len(images)):
        print("Finding channel alignment for round", i)

        # --- Extract and preprocess channel 2 ---
        c2 = images[i][2]
        c2 = np.expand_dims(np.stack([c2] * 4, axis=0), axis=1)
        c2 = bardensr.preprocessing.background_subtraction((c2 / np.max(c2)).astype('float'), [0, 5, 5])
        c2 = np.sum(c2[:, 0], axis=0)
        c2 = np.clip(c2, 0, np.percentile(c2.ravel(), 99.5))
        c2 = ((c2 / np.max(c2)) * 255).astype('uint8')

        # --- Extract and preprocess channel 3 ---
        c3 = images[i][3]
        c3 = np.expand_dims(np.stack([c3] * 4, axis=0), axis=1)
        c3 = bardensr.preprocessing.background_subtraction((c3 / np.max(c3)).astype('float'), [0, 5, 5])
        c3 = np.sum(c3[:, 0], axis=0)
        c3 = np.clip(c3, 0, np.percentile(c3.ravel(), 99.5))
        c3 = ((c3 / np.max(c3)) * 255).astype('uint8')

        # --- Match features and estimate transform ---
        keypoints1, keypoints2, matches = detect_and_match(c3, c2, use_cv2_blob_detector=True)
        print("Total matches:", len(matches))

        num_good_matches = int(len(matches) * 0.7)
        matches = matches[:num_good_matches]

        src_pts_all = np.float32([keypoints1[m.queryIdx].pt for m in matches])
        dst_pts_all = np.float32([keypoints2[m.trainIdx].pt for m in matches])
        distances = np.linalg.norm(src_pts_all - dst_pts_all, axis=1)
        filtered_indices = np.where(distances < 10)[0]

        src_pts = src_pts_all[filtered_indices].reshape(-1, 1, 2)
        dst_pts = dst_pts_all[filtered_indices].reshape(-1, 1, 2)
        print("Filtered matches:", len(src_pts))

        H, _ = cv2.findHomography(src_pts, dst_pts, cv2.RANSAC, 1.0)
        transforms.append(H)

    save_hdf5(transforms, path + "output/transforms.hdf5")




def save_hdf5(matrix, file_path): #assumes this is a list of np arrays
    f = h5py.File(file_path,'w')
    grp = f.create_group('list')
    for i,arr in enumerate(matrix):
        grp.create_dataset(str(i), data=arr)
    f.close()
    return None




def open_hdf5(file_path): #assumes this is a list of np arrays
    var_name= []
    f = h5py.File(file_path)
    print(f)
    data = f['list']
    for i in range(len(data)):
        var_name.append(data[str(i)][:])
    f.close()
    print(len(var_name))
    print(len(var_name[0]))
    return var_name




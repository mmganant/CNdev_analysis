rule find_thresh_find_no_final:
	input:
		genes_calls = expand([path+"output/thresh_refined{FOV}.txt"], FOV = FOV_minmax),
		thresh_path = path+"output/initial_threshold.txt"
	params:
		codeflat = codeflat,

rule find_initial_thresh_median:
    input:
        initial_thresh = expand([path + "output/initial_thresh{FOV}.txt"], FOV = FOVs)
    output:
        [path+"output/initial_threshold.txt"]
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values
    run:
        if find_threshold == True:
            ercc_maxes = []
            for init in input.initial_thresh:
                with open(init, 'r') as file:
                    raw_value = file.read().strip()
    		    thresh_calc = np.fromstring(raw_value.strip('[]'), sep=' ')
            # Parse tuple-like string and extract the float
                ercc_maxes.append(thresh_calc)
            ercc_maxes = np.array(ercc_maxes) # This is the max values of all unused barcodes in all fovs. 
            initial_threshold = np.median(np.median(ercc_maxes, axis=1))
            with open(path+"output/initial_threshold.txt", 'w') as file:
                 file.write(f"{initial_threshold}\n")
        else:
            with open(path+"output/initial_threshold.txt", 'w') as file:
                 file.write(f"{thresh_refined}\n")


####################################################################
# Example: Single rule that handles DAPI or NISSL or both 
#          via the cell_segmentation_method variable.
####################################################################

rule cell_segmentation:
    input:
        # We define a dynamic function that returns the union of any required files.
        # E.g. if cell_segmentation_method = "dapi", we return only dapi files;
        # if it's "maxdapienissl", we return both sets, etc.
        lambda wc: (
            # Start with an empty list:
            []
            # If the method uses DAPI, include dapi files
            + ([path + f"output/fov{wc.FOV}_dapi.hdf5"]
               if cell_segmentation_method in ["dapi", "dapi_partialz", "maxdapi+nissl"]
               else [])
            # If the method uses NISSL, include nissl files
            + ([path + f"output/fov{wc.FOV}_nissl.hdf5"]
               if cell_segmentation_method in ["nissl", "maxdapi+nissl"]
               else [])
        )
    params:
        expand_dist      = expand_mask,
        positions_glob   = positions_glob
    output:
        # For output, you might want just one type of file in all cases,
        # e.g. "fov{FOV}_dapi_mask_exp.hdf5". But if “nissl” is truly different,
        # you may want "fov{FOV}_nissl_mask_exp.hdf5" in that case.
        # This example always creates dapi_mask_exp names for each FOV,
        # but you can do something more sophisticated if you like:
        temp(path + "output/fov{FOV}_dapi_mask_exp.hdf5")
    wildcard_constraints:
        FOV = r"\d+"
    run:
        import pandas as pd
        positions_glob_df = pd.read_csv(params.positions_glob)
        # If we are in “dapi_partialz” or “dapi” or “maxdapi+nissl,”
        # we’ll find those dapi files in input. If we’re in “nissl” or
        # “maxdapi+nissl,” we can open them by doing the "replace(...)" trick.

        if cell_segmentation_method == "dapi_partialz":
            # We only have DAPI files in input
            for dapi_file in sorted(input):
                if "dapi.hdf5" not in dapi_file:
                    continue
                dapi_image = open_hdf5(dapi_file)
                dapi_image = np.stack(dapi_image, axis=0)
                fov_sample = int(dapi_file.split("fov")[-1].split("_")[0])
                dapi_partialz_seg(
                    dapi_image, fov_sample, params.expand_dist )

        elif cell_segmentation_method == "maxdapi+nissl":
            # We have both dapi and nissl in input
            # so we can pair them up by name or just find DAPI
            # and call .replace(...) to get the matching NISSL
            dapi_files = [f for f in input if "dapi.hdf5" in f]
            for dapi_file in sorted(dapi_files):
                nissl_file = dapi_file.replace("dapi", "nissl")
                dapi_image  = np.stack(open_hdf5(dapi_file),  axis=0)
                nissl_image = np.stack(open_hdf5(nissl_file), axis=0)
                fov_sample  = int(dapi_file.split("fov")[-1].split("_")[0])
                segment_maxproj_images(
                    dapi_image, nissl_image, fov_sample, params.expand_dist, 
                    cellpose_model=cellpose_model, cellpose_channel=[2,3],
                    cellpose_diameter=cellpose_diamter
                )

        elif cell_segmentation_method == "dapi":
            # Only dapi in input
            dapi_files = [f for f in input if "dapi.hdf5" in f]
            for dapi_file in sorted(dapi_files):
                dapi_image = np.stack(open_hdf5(dapi_file), axis=0)
                fov_sample = int(dapi_file.split("fov")[-1].split("_")[0])
                segment_maxproj_images(
                    dapi_image, None, fov_sample, params.expand_dist,
                    cellpose_model=cellpose_model, cellpose_channel=[0,0]
                )

        elif cell_segmentation_method == "nissl":
            # Only nissl in input
            nissl_files = [f for f in input if "nissl.hdf5" in f]
            for nissl_file in sorted(nissl_files):
                nissl_image = np.stack(open_hdf5(nissl_file), axis=0)
                fov_sample  = int(nissl_file.split("fov")[-1].split("_")[0])
                segment_maxproj_images(
                    None, nissl_image, fov_sample, params.expand_dist,
                    cellpose_model=cellpose_model, cellpose_channel=[2,3],
                    cellpose_diameter=cellpose_diamter
                )


rule stitch_fovs_genes:
    input:
        fov_files = expand(path + "output/fov{FOV}_genemapped.csv", FOV=FOVs)
    params:
        positions_glob = positions_glob
    output:
        temp(path + "output/genes_all_fovs.csv")
    wildcard_constraints:
        FOV = r"\d+"  # Only numeric FOV values
    run:
        import pandas as pd
        import numpy as np
        
        # Read positions data
        positions_glob = pd.read_csv(params.positions_glob)
        print(positions_glob)
        
        gene_called_all_fovs = pd.DataFrame()
        
        # Process each FOV file
        for fov_file in input.fov_files:
            gene_called_sample = pd.read_csv(fov_file)
            
            # Extract FOV sample ID from the file path
            fov_sample = int(fov_file.split('fov')[-1].split('.')[0].split('_')[0])
            print(f"Processing FOV: {fov_sample}")
            
            # Calculate global coordinates
            gene_called_sample['globX'] = (
                gene_called_sample['m2'] + np.max(positions_glob['X']) -  positions_glob.loc[fov_sample, 'X'] - 2304 / 2).astype(int)
            
            gene_called_sample['globY'] = (
                np.max(positions_glob['Y']) - positions_glob.loc[fov_sample, 'Y'] + gene_called_sample['m1']).astype(int)
            
            # Concatenate results
            gene_called_all_fovs = pd.concat([gene_called_all_fovs, gene_called_sample], ignore_index=True)
        
        # Remove duplicates and save to output
        gene_called_all_fovs.drop_duplicates(inplace=True)
        gene_called_all_fovs.to_csv(path + "output/genes_all_fovs.csv", index=False)




rule call_genes:

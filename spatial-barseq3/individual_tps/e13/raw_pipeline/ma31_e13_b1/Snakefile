        for fov_file in input.fov_files:  # Loop through all FOV input files
            if ['bardensr'] == refine_registration:
                images = open_hdf5(fov_file)  # Load the input file
                images = np.stack(images)     
                fov_sample = int(fov_file.split('fov')[-1].split('_')[0])

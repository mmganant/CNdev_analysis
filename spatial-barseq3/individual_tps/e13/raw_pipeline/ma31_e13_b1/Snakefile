                mask = np.stack(mask)
                #image_maskapp = apply_mask_to_images(images, mask)
                print(fov_file.split('fov')[-1].split('_'))
                print("fov_sample: "+str(fov_sample))
                register_fovs_bardensr(images, mask, params.codeflat, fov_sample, max_wiggle = params.max_wiggle,  niter = params.niter)# Loop through all FOV input files
            if ['bspline'] ==  refine_registration:
                images = open_hdf5(fov_file)  # Load the input file
                images = np.stack(images)
                fov_sample = int(fov_file.split('fov')[-1].split('_')[0])
                mask = open_hdf5(path + "output/fov"+str(fov_sample)+ "_mask.hdf5")
                mask = np.stack(mask)
                #image_maskapp = apply_mask_to_images(images, mask)
                print(fov_file.split('fov')[-1].split('_'))
                print("fov_sample: "+str(fov_sample))
                register_fovs_bspline(images, mask, params.codeflat, fov_sample, max_wiggle = params.max_wiggle,  niter = params.niter) # Loop through all FOV input files
            if ['bardensr', 'bspline'] == refine_registration:
                images = open_hdf5(fov_file)  # Load the input file
                images = np.stack(images)
                fov_sample = int(fov_file.split('fov')[-1].split('_')[0])
                mask = open_hdf5(path + "output/fov"+str(fov_sample)+ "_mask.hdf5")
                mask = np.stack(mask)
                #image_maskapp = apply_mask_to_images(images, mask)
                print(fov_file.split('fov')[-1].split('_'))
                print("fov_sample: "+str(fov_sample))
                register_fovs_both(images, mask, params.codeflat, fov_sample, max_wiggle = params.max_wiggle,  niter = params.niter)

            if [] == refine_registration:
                images = open_hdf5(fov_file)  # Load the input file
                images = np.stack(images)
                mask = open_hdf5(path + "output/fov"+str(fov_sample)+ "_mask.hdf5")
                mask = np.stack(mask)
                image_maskapp = apply_mask_to_images(images, mask) 
                fov_sample = int(fov_file.split('fov')[-1].split('_')[0])
                save_hdf5(images_maskapp, path+"output/fov"+str(fov_sample)+"_reg.hdf5")



			print("thresh_refined: "+str(thresh_ref))
			with open(path+"output/thresh_refined.txt", 'w') as file:
				file.write(f"{thresh_ref}\n")
		else:
			with open(path+"output/thresh_refined.txt", 'w') as file:
				file.write(f"{thresh_refined}\n") 
















rule refine_reg:
    input:
        fov_files = [path+"output/fov{FOV}_norm_mm2.hdf5"],
